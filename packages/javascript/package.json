{
  "name": "rest-exchange-protocol",
  "version": "0.1.0",
  "main": "dist/server/index.js",
  "types": "dist/server/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    },
    "./package.json": "./package.json"
  },
  "repository": "https://github.com/firecraftgaming/rest-exchange-protocol.git",
  "author": "Eliyah Sundström <eliyah@sundstroem.com>",
  "license": "MIT",
  "files": [
    "dist",
    "package.json",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "webpack && tsc --emitDeclarationOnly",
    "watch": "webpack --watch",
    "test": "TSX_TSCONFIG_PATH=./test/tsconfig.json mocha 'test/**/*.test.ts'",
    "test:coverage": "TSX_TSCONFIG_PATH=./test/tsconfig.json nyc mocha 'test/**/*.test.ts'",
    "lint": "eslint src test --ext .ts",
    "lint:fix": "eslint src test --ext .ts --fix"
  },
  "dependencies": {
    "axios": "^1.3.5",
    "isomorphic-ws": "^5.0.0",
    "uuid": "^9.0.0",
    "ws": "^8.13.0"
  },
  "devDependencies": {
    "@babel/core": "^7.19.3",
    "@babel/plugin-transform-typescript": "^7.21.3",
    "@babel/preset-env": "^7.19.3",
    "@babel/preset-typescript": "^7.18.6",
    "@testdeck/mocha": "^0.3.3",
    "@types/node": "^18.0.0",
    "@typescript-eslint/eslint-plugin": "^5.52.0",
    "@typescript-eslint/parser": "^5.52.0",
    "babel-loader": "^8.2.5",
    "chai": "^4.3.7",
    "eslint": "^8.34.0",
    "mocha": "^10.2.0",
    "mocha-typescript": "^1.1.17",
    "nyc": "^15.1.0",
    "ts-mockito": "^2.6.1",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.1.2",
    "tsx": "^4.23.13",
    "typescript": "^4.9.5",
    "webpack": "^5.69.0",
    "webpack-cli": "^4.9.2"
  }
}
